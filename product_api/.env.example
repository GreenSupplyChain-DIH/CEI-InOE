# Copy to product_api/.env (never commit the real file).

# --- Runtime -----------------------------------------------------------------
PRODUCT_API_ENV=production
# oidc (production) or mock (only with PRODUCT_API_ENV=development)
PRODUCT_API_AUTH_MODE=oidc

# --- Database: read-only role created by the Alembic revision a8b9c0d1e2f3 ----
# Set the role password with PRODUCT_API_DB_PASSWORD when running `alembic upgrade head`
# (or ALTER ROLE product_api_ro PASSWORD '...'), then use the same value here.
PRODUCT_API_DATABASE_URL=postgresql://product_api_ro:CHANGE_ME@postgres:5432/ocei

# --- Limits / policy -----------------------------------------------------------
PRODUCT_API_MAX_DAYS=31
PRODUCT_API_RATE_LIMIT_PER_MINUTE=60
PRODUCT_API_ALLOWED_PURPOSES=sustainability-analysis

# --- OIDC (values to be agreed with the FDC / CEADS integration team) -----------
PRODUCT_API_OIDC_ISSUER=https://issuer.example.org/realms/fdc
PRODUCT_API_OIDC_AUDIENCE=cei-inoe-product-api
PRODUCT_API_OIDC_JWKS_URL=https://issuer.example.org/realms/fdc/protocol/openid-connect/certs
PRODUCT_API_OIDC_ALGORITHMS=RS256,ES256
PRODUCT_API_OIDC_LEEWAY_SECONDS=30
PRODUCT_API_ALLOWED_CONNECTOR_CLIENT_IDS=fdc-provider-gateway
# Claim names (adjust to the actual token layout)
PRODUCT_API_CLAIM_CLIENT_ID=azp
PRODUCT_API_CLAIM_PARTICIPANT=participant_id
PRODUCT_API_CLAIM_PURPOSE=purpose
PRODUCT_API_CLAIM_CONTRACT=contract_id
PRODUCT_API_CLAIM_REQUEST_ID=request_id

# --- Governance placeholders (set before external sharing) ----------------------
PRODUCT_API_INCIDENT_CONTACT=unconfigured

# --- compose-only variables (read by docker-compose.product-api.yml) ------------
# PRODUCT_API_SITE_REGISTRY_FILE=./product_api/site_product_registry.yaml
# CEI_INOE_DB_NETWORK=cei-inoe_default
